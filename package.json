{
  "name": "dsh-session-tree",
  "version": "0.1.0",
  "description": "Session Tree: a per-workspace map of DeepSeek Harness sessions, turns and fork branches in the Web UI",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/render-smoke.mjs",
    "test:layout": "node test/diagnose-layout.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session-tree",
    "conversation-map",
    "fork",
    "branch"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lulaalu/dsh-session-tree.git"
  },
  "homepage": "https://github.com/lulaalu/dsh-session-tree#readme",
  "bugs": {
    "url": "https://github.com/lulaalu/dsh-session-tree/issues"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=22.0.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
